import dash
from dash import dcc, html
import plotly.graph_objs as go
import numpy as np

# Initialize app
app = dash.Dash(__name__)

# ---- Sample simulation data ----
time = np.linspace(0, 500, 200)

efficiency = np.piecewise(
    time,
    [time < 450, time >= 450],
    [lambda t: 0, lambda t: 70 + 3 * np.sin(0.2 * t)]
)

waste = 100 - efficiency

# ---- Layout ----
app.layout = html.Div([

    html.H2(
        "Hospital Operations Analytics & Simulation",
        style={'textAlign': 'center'}
    ),

    # ---- KPI Section ----
    html.Div([
        html.H4("Hospital Efficiency Dashboard"),

        html.Div([
            html.Div([
                html.P("EFFICIENCY"),
                html.H3(f"{np.mean(efficiency):.1f}%"),
            ], style={'width': '30%', 'textAlign': 'center'}),

            html.Div([
                html.P("RESOURCE WASTE"),
                html.H3(f"{np.mean(waste):.1f}%"),
            ], style={'width': '30%', 'textAlign': 'center'}),

            html.Div([
                html.P("DATA ACCURACY"),
                html.H3("96.4%"),
            ], style={'width': '30%', 'textAlign': 'center'}),
        ], style={
            'display': 'flex',
            'justifyContent': 'space-around'
        })
    ], style={'marginBottom': '20px'}),

    # ---- Process Flow ----
    html.Div([
        html.Div("TRIAGE", style={'width': '30%', 'textAlign': 'center'}),

        html.Div([
            html.Div("IDENTIFIED", style={
                'border': '2px solid green',
                'borderRadius': '10px',
                'padding': '5px',
                'display': 'inline-block'
            }),
            html.Div("ANALYSIS", style={'marginTop': '10px'})
        ], style={'width': '30%', 'textAlign': 'center'}),

        html.Div("OUTCOME", style={'width': '30%', 'textAlign': 'center'}),
    ], style={
        'display': 'flex',
        'justifyContent': 'space-around',
        'marginBottom': '40px'
    }),

    # ---- Graph ----
    dcc.Graph(
        id='performance-graph',
        figure={
            'data': [
                go.Scatter(
                    x=time,
                    y=efficiency,
                    mode='lines',
                    name='Efficiency'
                ),
                go.Scatter(
                    x=time,
                    y=waste,
                    mode='lines',
                    name='Waste',
                    line=dict(dash='dash')
                ),
            ],
            'layout': go.Layout(
                xaxis={'title': 'Simulation Time (s)'},
                yaxis={'title': 'Score (%)', 'range': [0, 100]},
                hovermode='closest'
            )
        }
    )
])

# ---- Run server ----
if __name__ == '__main__':
    app.run(debug=True)
  

